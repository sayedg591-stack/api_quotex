# ============================================================================
# Quotex Signal Platform — Environment Variables Template
# Copy to `.env` (or set as Replit Secrets) and fill in real values.
# NEVER commit a filled-in .env file. This file must only contain placeholders.
# ============================================================================

# ── Quotex session (preferred: use QUOTEX_SSID, avoids storing a password) ──
# Session ID captured from an authenticated Quotex browser session.
# If set, this takes priority over session.json / email+password login.
QUOTEX_SSID=

# ── Quotex login (fallback, only used if QUOTEX_SSID is not set) ───────────
QX_EMAIL=
QX_PASSWORD=

# ── Flask / Gunicorn server ─────────────────────────────────────────────────
PORT=5000
WEB_CONCURRENCY=2

# ── Connection tuning (optional — sensible defaults exist in code) ─────────
PING_INTERVAL=25
PING_TIMEOUT=5
MAX_RECONNECT_ATTEMPTS=5

# ── Trading engine limits (analysis-only; no order placement) ──────────────
MIN_ORDER_AMOUNT=1.0
MAX_ORDER_AMOUNT=50000.0
DEFAULT_TIMEOUT=30.0

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=
